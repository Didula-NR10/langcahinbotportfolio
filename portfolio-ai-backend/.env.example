PORTFOLIO_APP_NAME="Portfolio AI Chatbot API"
PORTFOLIO_APP_ENVIRONMENT=development
PORTFOLIO_DEBUG=false
PORTFOLIO_API_VERSION=v1
PORTFOLIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORTFOLIO_LOG_LEVEL=INFO
PORTFOLIO_API_HOST=127.0.0.1
PORTFOLIO_API_PORT=8000
# Set the key locally in .env or the process environment. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_QUESTION_CHARS=4000
LLM_MAX_RESPONSE_CHARS=8000
KNOWLEDGE_MODE=direct_context
KNOWLEDGE_PATH=app/knowledge
RAG_TOP_K=4
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_MAX_CONTEXT_CHARS=6000
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
VECTOR_DB_PATH=data/chroma
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_HISTORY_CHARS=6000
CHAT_SESSION_TTL_MINUTES=60
CHAT_MAX_ACTIVE_SESSIONS=1000
CHAT_MAX_REQUEST_BYTES=16384
RATE_LIMIT_REQUESTS_PER_MINUTE=5
RATE_LIMIT_REQUESTS_PER_HOUR=50
GLOBAL_REQUESTS_PER_MINUTE=100
MAX_CONCURRENT_CHAT_REQUESTS=4
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-ai-chatbot
LANGSMITH_INCLUDE_CONVERSATION_DATA=false
ADMIN_KNOWLEDGE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ADMIN_USER_IDS=
SUPABASE_DOCUMENT_BUCKET=portfolio-knowledge
DOCUMENT_MAX_FILE_SIZE_MB=15
DOCUMENT_MAX_FILES_PER_UPLOAD=10
DOCUMENT_CHUNK_SIZE=700
DOCUMENT_CHUNK_OVERLAP=100
DOCUMENT_EMBEDDING_DIMENSIONS=768
DOCUMENT_MAX_COSINE_DISTANCE=0.45
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_TEXT_CHARS=200000
DOCUMENT_MAX_CHUNKS=300
DOCUMENT_EMBED_BATCH_SIZE=32
